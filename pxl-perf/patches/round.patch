 // ---------------------------------------------------------------------------
 // Math
 
+/**
+ * Rounds down. floorf() is a library call on x86-64 without SSE4.1; this is
+ * not. Floats from 2^23 up are whole numbers already.
+ */
+static float pxl__floor(float value) {
+  if (!(fabsf(value) < 8388608.0f)) {
+    return value;
+  }
+  float whole = (float)(int32_t)value;
+  return whole > value ? whole - 1.0f : whole;
+}
+
 static float pxl__round(float value) {
-  return floorf(value + 0.5f);
+  return pxl__floor(value + 0.5f);
 }
 
