 /** Drops the draws of the frame, and frees what the frame destroyed. */
 static void pxl__reset_frame(pxl_context* ctx) {
+  if (ctx->upload_count > 0) {
+    // The frame did not record: upload the staged pixels now.
+    ctx->vertex_count = 0;
+    ctx->index_count  = 0;
+    SDL_GPUCommandBuffer* cmd = SDL_AcquireGPUCommandBuffer(ctx->device);
+    if (!cmd || !pxl__upload_geometry(ctx, cmd) ||
+        !SDL_SubmitGPUCommandBuffer(cmd)) {
+      pxl__fail(ctx, SDL_GetError());
+    }
+    ctx->upload_count = 0;
+    ctx->staged_size  = 0;
+  }
   ctx->in_frame      = false;
   ctx->vertex_count  = 0;
   ctx->index_count   = 0;
