+/** Copies w * h pixels to `dst`, and premultiplies them if needed. */
+static void pxl__copy_pixels(uint8_t* dst, size_t w, size_t h,
+                             const void* pixels, size_t pitch,
+                             bool premultiplied) {
+  size_t row = w * 4u;
+  if (!pixels) {
+    memset(dst, 0, row * h);
+    return;
+  }
+  const uint8_t* source = pixels;
+  for (size_t j = 0; j < h; ++j) {
+    uint8_t* line = dst + (j * row);
+    memcpy(line, source + (j * pitch), row);
+    if (!premultiplied) {
+      for (size_t i = 0; i < row; i += 4) {
+        line[i + 0] = pxl__premultiply(line[i + 0], line[i + 3]);
+        line[i + 1] = pxl__premultiply(line[i + 1], line[i + 3]);
+        line[i + 2] = pxl__premultiply(line[i + 2], line[i + 3]);
+      }
+    }
+  }
+}
