+/** Plain color rectangles that a shape reserves at once. */
+typedef struct pxl__fills {
+  pxl__vertex* next;
+  /** The reserved quads that are not written yet. */
+  size_t free;
+  pxl_color color;
+  int width, height;
+} pxl__fills;
+
+/** Reserves at most `max_quads` rectangles of target pixels. */
+static pxl__fills pxl__begin_fills(pxl_context* ctx, size_t max_quads,
+                                   pxl_color color) {
+  const pxl_texture* target = pxl__target(ctx);
+  pxl__vertex* vertices     = pxl__append(ctx, nullptr, max_quads);
+  return (pxl__fills){
+      .next   = vertices,
+      .free   = vertices ? max_quads : 0,
+      .color  = color,
+      .width  = target->width,
+      .height = target->height,
+  };
+}
+
+/** Adds a rectangle of target pixels. The transform does not apply. */
+static void pxl__add_fill(pxl__fills f[static 1], int x, int y, int w, int h) {
+  if (f->free == 0 || w <= 0 || h <= 0 || x >= f->width || y >= f->height ||
+      x + w <= 0 || y + h <= 0) {
+    return;
+  }
+  float x0           = (float)x;
+  float y0           = (float)y;
+  float x1           = (float)x + (float)w;
+  float y1           = (float)y + (float)h;
+  const float px[]   = {x0, x1, x1, x0};
+  const float py[]   = {y0, y0, y1, y1};
+  const float u[]    = {0.0f, 1.0f, 1.0f, 0.0f};
+  const float v[]    = {0.0f, 0.0f, 1.0f, 1.0f};
+  for (size_t i = 0; i < 4; ++i) {
+    f->next[i] = (pxl__vertex){
+        .x      = px[i],
+        .y      = py[i],
+        .u      = u[i],
+        .v      = v[i],
+        .color  = f->color,
+        .params = {255},
+    };
+  }
+  f->next += 4;
+  f->free -= 1;
+}
+
+/** Gives back the reserved quads that the shape did not use. */
+static void pxl__end_fills(pxl_context* ctx, const pxl__fills f[static 1]) {
+  if (f->next && f->free > 0) {
+    ctx->vertex_count -= f->free * 4;
+    ctx->commands[ctx->command_count - 1].quad_count -= (uint32_t)f->free;
+  }
+}
