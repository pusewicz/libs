+/** Creates the index buffer: quad q is the triangles 012 and 023 of 4 q. */
+static bool pxl__create_quad_indices(pxl_context* ctx) {
+  constexpr Uint32 size = sizeof(uint16_t) * 6 * pxl__quads_per_draw;
+  ctx->index_buffer     = SDL_CreateGPUBuffer(
+      ctx->device, &(SDL_GPUBufferCreateInfo){
+                           .usage = SDL_GPU_BUFFERUSAGE_INDEX, .size = size});
+  SDL_GPUTransferBuffer* transfer = SDL_CreateGPUTransferBuffer(
+      ctx->device, &(SDL_GPUTransferBufferCreateInfo){
+                       .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+                       .size  = size,
+                   });
+  uint16_t* indices =
+      transfer ? SDL_MapGPUTransferBuffer(ctx->device, transfer, false)
+               : nullptr;
+  if (!ctx->index_buffer || !indices) {
+    SDL_ReleaseGPUTransferBuffer(ctx->device, transfer);
+    return false;
+  }
+  const uint16_t order[] = {0, 1, 2, 0, 2, 3};
+  for (size_t i = 0; i < 6 * (size_t)pxl__quads_per_draw; ++i) {
+    indices[i] = (uint16_t)(((i / 6) * 4) + order[i % 6]);
+  }
+  SDL_UnmapGPUTransferBuffer(ctx->device, transfer);
+  SDL_GPUCommandBuffer* cmd = SDL_AcquireGPUCommandBuffer(ctx->device);
+  if (!cmd) {
+    SDL_ReleaseGPUTransferBuffer(ctx->device, transfer);
+    return false;
+  }
+  SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+  SDL_UploadToGPUBuffer(
+      copy, &(SDL_GPUTransferBufferLocation){.transfer_buffer = transfer},
+      &(SDL_GPUBufferRegion){.buffer = ctx->index_buffer, .size = size},
+      false);
+  SDL_EndGPUCopyPass(copy);
+  bool submitted = SDL_SubmitGPUCommandBuffer(cmd);
+  SDL_ReleaseGPUTransferBuffer(ctx->device, transfer);
+  return submitted;
+}
